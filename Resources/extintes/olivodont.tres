[resource]
script = ExtResource("1_ext")
id = "olivodont"
nom = "Olivodont"
descripcio = "Un mamut petit d'ullals corbats, gran devorador d'olives. Els seus ullals són molt buscats."
epoca = "L'època del gel mediterrani"
parts = Array[ExtResource("2_part")]([SubResource("Part_pota"), SubResource("Part_molar"), SubResource("Part_ullal"), SubResource("Part_crani")])
frequencia = 0.9
habilitat_reviscuda = "Sacseja els arbres i en fa caure olives."
color = Color(0.6, 0.55, 0.45, 1)

[resource]
script = ExtResource("1_ext")
id = "vermutosaure"
nom = "Vermutosaure"
descripcio = "Un rèptil enorme que pasturava entre vinyes salvatges. Diuen que el seu alè feia olor d'herbes aromàtiques."
